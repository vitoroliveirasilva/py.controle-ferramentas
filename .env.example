PROJECT_NAME=Sistema de Controle de Ferramentas
APP_VERSION=0.1.0
APP_ENV=development
FLASK_DEBUG=1

SECRET_KEY=secret-key
WTF_CSRF_ENABLED=1

SERVER_HOST=0.0.0.0
SERVER_PORT=8000
LOG_LEVEL=INFO

SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=0
PERMANENT_SESSION_LIFETIME_MINUTES=480
MAX_CONTENT_LENGTH_MB=16
FORCE_HTTPS_HEADERS=0
APP_TRUST_PROXY_HEADERS=0

# Para configurar o BD, é possível usar uma URL de conexão completa ou montar a string de conexão usando variáveis individuais
# A opção A tem prioridade sobre a opção B se ambas forem fornecidas

# Opção A:
DATABASE_URL=

# Opção B:
SQLSERVER_DRIVER=ODBC Driver 17 for SQL Server
SQLSERVER_HOST=
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=
SQLSERVER_USERNAME=
SQLSERVER_PASSWORD=
SQLSERVER_TRUSTED_CONNECTION=0
SQLSERVER_ENCRYPT=yes
SQLSERVER_TRUST_SERVER_CERTIFICATE=yes
SQLSERVER_CONNECTION_TIMEOUT=30
SQLSERVER_FAST_EXECUTEMANY=1

SQLALCHEMY_ECHO=0
SQLALCHEMY_POOL_RECYCLE=1800

# Microsoft Entra ID / Azure AD
AUTH_MICROSOFT_TENANT_ID=
AUTH_MICROSOFT_CLIENT_ID=
AUTH_MICROSOFT_CLIENT_SECRET=
AUTH_MICROSOFT_REDIRECT_URI=http://localhost:5000/auth/callback
AUTH_MICROSOFT_REDIRECT_PATH=/auth/callback
AUTH_MICROSOFT_SCOPES=User.Read
AUTH_ALLOWED_EMAIL_DOMAINS=

# Apenas para desenvolvimento/testes locais sem chamar a Microsoft
# ATENÇÃO: NUNCA HABILITAR EM PRODUÇÃO
AUTH_DEV_LOGIN_ENABLED=0

BOOTSTRAP_CSS_URL=https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css
BOOTSTRAP_JS_URL=https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js

# Notificações internas e envio de e-mail corporativo
# E-mail deve sair pelo Brasif Gateway Microsoft Graph, nunca por SMTP
NOTIFICATIONS_EMAIL_ENABLED=0
BRASIF_GATEWAY_BASE_URL=https://howard.brasif.local
BRASIF_GATEWAY_API_KEY=
BRASIF_GATEWAY_TIMEOUT_SECONDS=10
BRASIF_GATEWAY_VERIFY_SSL=true
BRASIF_GATEWAY_MAX_RETRIES=2
BRASIF_GATEWAY_RETRY_BACKOFF_SECONDS=0.25
MAIL_DEFAULT_SENDER=
MAIL_MAX_RECIPIENTS=50
MAIL_MAX_BODY_LENGTH=50000
MAIL_MAX_ATTACHMENT_MB=10

# Transferências
TRANSFER_EXPIRATION_DAYS=7

# Relatórios e exportações
REPORT_EXPORT_MAX_ROWS=500

# Uploads e evidências operacionais
UPLOAD_BASE_DIR=
TOOL_REFERENCE_PHOTO_MAX_MB=8
INVENTORY_EVIDENCE_MAX_MB=8
OCCURRENCE_ATTACHMENT_MAX_MB=8
ALLOWED_IMAGE_EXTENSIONS=png,jpg,jpeg,webp
ALLOWED_EVIDENCE_EXTENSIONS=pdf,png,jpg,jpeg,webp
ALLOWED_OCCURRENCE_ATTACHMENT_EXTENSIONS=pdf,png,jpg,jpeg,webp
